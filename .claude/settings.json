{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Edit(//home/mori-akira/git/tank-simulator/**)",
      "Write(//home/mori-akira/git/tank-simulator/**)",
      "Edit(//tmp/claude-1000/**)",
      "Write(//tmp/claude-1000/**)"
    ],
    "deny": [
      "Edit(//home/mori-akira/git/tank-simulator/.git/**)",
      "Write(//home/mori-akira/git/tank-simulator/.git/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh auth:*)",
      "Bash(npm publish:*)",
      "Bash(npm login:*)",
      "Bash(npm unpublish:*)",
      "Bash(npm owner:*)",
      "Bash(npm access:*)",
      "Bash(npm token:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-commit.sh\"",
            "timeout": 180,
            "statusMessage": "npm run verify を実行中..."
          }
        ]
      }
    ]
  }
}
