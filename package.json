{
  "name": "tank-simulator",
  "version": "0.1.0",
  "description": "ブラウザ上で動作する戦車シミュレータゲーム",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "depcruise": "depcruise src tests tools",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shot": "playwright test tests/e2e/shot.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/three": "0.185.4",
    "dependency-cruiser": "18.1.1",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
